# Copy to .env and fill in. .env is gitignored; never commit it.
# Values are compiled into the flash image (see README).
# Placeholders in <angle brackets> are rejected by the build.
# Comments must be on their own line (no trailing "# ..." after a value).

# Required
WIFI_SSID=<your-wifi-ssid>
# WPA2 password, 8-63 characters
WIFI_PASSWORD=<your-wifi-password>
# Pixels on the strip at LED_GPIO (default 18), one per drawer, 1-30
LED_COUNT=<1-30>
# Which cabinet this board serves: A or B
CABINET=<A|B>
# Physical drawer of each pixel, in pixel order. Codes start with the cabinet letter,
# no duplicates, and the count must equal LED_COUNT. Example for cabinet A: A1,A2,A3,A4,A5
DRAWER_MAP=<A1,A2,A3,A4,A5>

# Optional: protects the web test page API (8-64 printable chars, no spaces). Empty = no auth.
# WEB_TOKEN=

# Bench builds only: 1 = also trust the mock IMS CA (tools/mock_ims.py). Default 0.
# IMS_MOCK_CA=0

# Optional until the IMS poller is implemented
# IMS_URL=https://ims.example/api/...
# IMS_TOKEN=
# DEVICE_ID=

# Optional (defaults shown)
# LED_GPIO=18
# POLL_INTERVAL_MS=5000
# GLOW_MS=5000
# GLOW_BRIGHTNESS_PCT=25
# GLOW_RGB=FFB46E
